{
  "name": "toot-together",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "start": "NODE_ENV=production node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "knip": "knip",
    "balance": "tsx scripts/balance.ts",
    "icons": "tsx scripts/icons.ts",
    "level-shots": "tsx scripts/level-shots.ts",
    "og": "tsx scripts/og.ts",
    "trailer": "node trailer/record.mjs",
    "trailer:dryrun": "tsx trailer/dryrun.ts"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "obscenity": "^0.4.6",
    "posthog-js": "^1.438.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "knip": "^6.42.1",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
