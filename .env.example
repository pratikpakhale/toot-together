# Copy to .env.local (never committed) and fill in.

# scripts/deploy.sh: the SSH target and public URL of the box set up by deploy/setup-server.sh.
DEPLOY_HOST=ubuntu@game.example.com
DEPLOY_URL=https://game.example.com

# Optional PostHog project key (phc_…). Production builds send analytics only when it's set.
VITE_POSTHOG_KEY=
